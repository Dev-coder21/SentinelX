# ==========================================
# SentinelX Environment Configuration
# ==========================================

# Database Connection (PostgreSQL)
# Local docker-compose: postgresql://sentinelx:sentinelx_password@localhost:5432/sentinelx_db
# Or hosted Supabase/Neon: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://sentinelx:sentinelx_password@localhost:5432/sentinelx_db

# News Ingestion (GDELT 2.0 Doc API is the active provider and requires NO API key)
# Optional fallback if using NewsAPI.org
NEWS_API_KEY=not_required_for_gdelt

# Weather Ingestion (Open-Meteo is the active provider and requires NO API key)
# Optional fallback if using NOAA
WEATHER_API_KEY=not_required_for_open_meteo

# LLM Configuration (STRICTLY Gemini API via Google AI Studio — never OpenAI or ChatGPT Plus)
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_gemini_api_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8000
